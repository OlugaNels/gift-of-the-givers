@model GiftOfTheGivers.Website.Models.ReliefProject

@{
    ViewData["Title"] = Model.Name;
    var badge = Model.Status switch
    {
        "Active" => "bg-success",
        "Completed" => "bg-secondary",
        _ => "bg-warning text-dark"
    };
    var pct = Model.GoalAmount > 0
        ? (int)Math.Min(100, (Model.RaisedAmount / Model.GoalAmount) * 100)
        : 0;
}

<div class="container py-5">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a class="text-decoration-none" asp-action="Index">Relief Projects</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <span class="badge @badge mb-2">@Model.Status</span>
            <h1 class="fw-bold mb-2">@Model.Name</h1>
            <p class="text-muted mb-4">
                @Model.Location &middot; Started @Model.StartDate.ToString("dd MMMM yyyy")
                @if (Model.EndDate.HasValue)
                {
                    <text>&middot; Ended @Model.EndDate.Value.ToString("dd MMMM yyyy")</text>
                }
            </p>
            <p class="lead">@Model.Description</p>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 fw-bold mb-0">Progress updates</h2>
                @if (User.IsInRole("Employee"))
                {
                    <a class="btn btn-sm btn-success" asp-action="PostUpdate" asp-route-id="@Model.Id">Post an update</a>
                }
            </div>

            @if (!Model.Updates.Any())
            {
                <div class="alert alert-secondary">
                    No updates have been posted for this project yet.
                </div>
            }
            else
            {
                foreach (var update in Model.Updates)
                {
                    <article class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-1">@update.Title</h3>
                            <p class="text-muted small mb-2">
                                Posted by @update.PostedBy on @update.PostedAt.ToString("dd MMM yyyy 'at' HH:mm")
                            </p>
                            <p class="card-text mb-0" style="white-space: pre-line;">@update.Body</p>
                        </div>
                    </article>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-bold text-uppercase text-muted">Funding</h2>
                    <div class="progress my-3" role="progressbar" aria-label="Funding progress"
                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
                        <div class="progress-bar bg-success" style="width: @pct%"></div>
                    </div>
                    <p class="mb-1"><strong>R @Model.RaisedAmount.ToString("N2")</strong> raised</p>
                    <p class="text-muted small mb-3">of a R @Model.GoalAmount.ToString("N2") goal (@pct%)</p>
                    <a class="btn btn-success w-100" asp-controller="Donation" asp-action="Create">Donate to this project</a>
                </div>
            </div>

            @if (User.IsInRole("Employee"))
            {
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body">
                        <h2 class="h6 fw-bold text-uppercase text-muted">Employee actions</h2>
                        <div class="d-grid gap-2 mt-3">
                            <a class="btn btn-outline-success btn-sm" asp-action="PostUpdate" asp-route-id="@Model.Id">Post progress update</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Edit project details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
