@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold text-danger mb-2">Something went wrong</h1>
            <p class="lead text-muted">
                An error occurred while processing your request. Please try again, or contact the
                Foundation if the problem persists.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a class="btn btn-success mt-3" asp-controller="Home" asp-action="Index">Return home</a>
        </div>
    </div>
</div>
