<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGivers.Website.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="no-print">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.svg" alt="Gift of the Givers" height="44" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ReliefProject" asp-action="Index">Relief Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Donation" asp-action="Create">Donate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Volunteer" asp-action="Create">Volunteer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>

                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-success" asp-controller="Employee" asp-action="Dashboard">Dashboard</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto border-top bg-light no-print">
        <div class="container py-4">
            <div class="row gy-3">
                <div class="col-md-5">
                    <img src="~/img/logo.svg" alt="Gift of the Givers" height="40" class="mb-2" />
                    <p class="text-muted small mb-0">
                        Africa's largest disaster response non-governmental organisation, delivering
                        humanitarian relief to communities affected by crisis.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-muted small fw-bold">Get involved</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="link-secondary text-decoration-none" asp-controller="Donation" asp-action="Create">Make a donation</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="Volunteer" asp-action="Create">Register as a volunteer</a></li>
                        <li><a class="link-secondary text-decoration-none" asp-controller="ReliefProject" asp-action="Index">Current relief projects</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="text-uppercase text-muted small fw-bold">Contact</h6>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li>info@giftofthegivers.org</li>
                        <li>+27 11 123 4567</li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="d-flex justify-content-between small text-muted">
                <span>&copy; 2026 Gift of the Givers Foundation</span>
                <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
