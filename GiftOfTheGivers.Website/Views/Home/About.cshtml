@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1 class="fw-bold mb-4">About Gift of the Givers</h1>

            <p class="lead text-muted">
                The Gift of the Givers Foundation is Africa's largest disaster response
                non-governmental organisation, providing swift and effective aid to communities
                struck by natural disasters and emergencies in South Africa and beyond.
            </p>

            <p>
                Established in response to the growing need for organised relief efforts, the
                Foundation operates on the principles of compassion, efficiency and resilience.
                With a diverse team of volunteers and specialists — medical personnel,
                search-and-rescue teams, logisticians and drivers — it delivers food, clean water,
                medical supplies and shelter to those affected by adversity.
            </p>

            <h2 class="h4 fw-bold mt-5 mb-3">About this platform</h2>
            <p>
                This web application is the Foundation's centralised hub for coordinating relief
                efforts. It brings three activities that were previously managed separately into
                one system:
            </p>

            <div class="row g-4 mt-1">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h3 class="h6 fw-bold">Donation management</h3>
                            <p class="card-text text-muted small mb-0">
                                One-time and recurring donations in multiple currencies, with a tax
                                certificate issued for every contribution.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h3 class="h6 fw-bold">Volunteer coordination</h3>
                            <p class="card-text text-muted small mb-0">
                                A register of volunteer skills and availability, so the right people
                                can be deployed to the right crisis quickly.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h3 class="h6 fw-bold">Relief project tracking</h3>
                            <p class="card-text text-muted small mb-0">
                                Live progress updates posted by Foundation staff, so donors and
                                volunteers can follow the work they support.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-secondary mt-5 small mb-0">
                <strong>Prototype notice.</strong> This application is a prototype developed for the
                APPR6312 Portfolio of Evidence. Donation values are symbolic, no payment is
                processed, and tax certificates are placeholders issued for demonstration only.
            </div>
        </div>
    </div>
</div>
