@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-4">@ViewData["Title"]</h1>

            <p class="lead text-muted">
                The Gift of the Givers Foundation collects only the personal information it needs
                in order to coordinate relief operations.
            </p>

            <h2 class="h5 fw-bold mt-4">What we collect</h2>
            <p>
                Volunteers provide their name, contact details, skills and availability so that
                coordinators can deploy them appropriately. Donors may provide a name and email
                address so that a tax certificate can be issued.
            </p>

            <h2 class="h5 fw-bold mt-4">Anonymous donations</h2>
            <p>
                Where a donor elects to give anonymously, no name or email address is stored
                against the donation record. Anonymity is enforced at the point the record is
                written, not merely hidden from display.
            </p>

            <h2 class="h5 fw-bold mt-4">How we protect it</h2>
            <p>
                Passwords are stored only as salted hashes. Access to volunteer and donation
                records is restricted to authenticated Foundation employees.
            </p>

            <div class="alert alert-secondary small mt-4 mb-0">
                <strong>Prototype notice.</strong> This page describes the intended handling of
                personal information for a prototype developed for the APPR6312 Portfolio of
                Evidence, and is not a binding privacy policy.
            </div>
        </div>
    </div>
</div>
